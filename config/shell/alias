# Aliases

alias c='clear'

# ls
alias ls='ls --color=auto --group-directories-first'
alias ll='ls -lahtr --color=auto --group-directories-first'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias tree='tree -C'

# navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# grep
alias grep='grep --colour=auto'
alias egrep='egrep --colour=auto'
alias fgrep='fgrep --colour=auto'

# xlip
alias xc='xclip'
alias xcs='xclip -selection clipboard'

# wifi
alias wcl='nmcli dev wifi list'
alias wcu='nmcli c up -a '
alias wcd='nmcli c down '

# Packages
alias q='doas pacman -Qs'
alias qr='doas pacman -Ss'
alias u='doas pacman -Syu'
alias uu='doas pacman -Syyu'
alias i='doas pacman -S'
alias r='doas pacman -Runc'

# Git
alias g='git'
alias gs='git status'
alias gl="git log --graph --pretty=format:'%C(yellow)%d%Creset %C(cyan)%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=short --all"
alias gac='git add . && git commit -m '
alias ga='git add '
alias gc='git commit -m '

# Docker
alias drm='docker rm -f '
alias dl='docker logs '

# ADB connect to device
alias adbc="adb kill-server;adb tcpip 5555;adb connect"

# Tools
alias mpip='curl https://checkip.amazonaws.com'
alias rand='f(){ cat /dev/urandom | tr -dc "a-zA-Z0-9/_+=*&^%$#@" | fold -w $1 | head -n 1 | xclip -selection clipboard; unset -f f; }; f'
