#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

[ -r /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

# Disable Ctrl+S
stty -ixon

# ── Git branch in prompt ───────────────────
git_branch() {
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) || \
    branch=$(git rev-parse --short HEAD 2>/dev/null) || return
    echo "(${branch})"
}

git_dirty() {
    [[ -n $(git status --porcelain 2>/dev/null) ]] && echo "* "
}

# ── PS1 ────────────────────────────────────
PS1='\[\033[38;5;142m\]\u\[\033[38;5;246m\]@\[\033[38;5;109m\]\h\[\033[38;5;246m\]: \[\033[38;5;214m\]\w/ '
PS1+='\[\033[38;5;175m\]$(git_branch)\[\033[38;5;203m\]$(git_dirty)\[\033[38;5;246m\]> \[\033[0m\]'

# ── History ────────────────────────────────
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
HISTIGNORE="ls:l:ll:la:cd:pwd:clear:c:exit"
shopt -s histappend
PROMPT_COMMAND="history -a; history -c; history -r"

# Import
source /usr/share/nvm/init-nvm.sh
source ~/src/config/shell/alias
source ~/src/config/shell/env
