super + Return
	st

super + shift + w
	firefox-developer

super + alt + w
	firefox-developer-edition

super + w
	surf duckduckgo.com

super + n
  mousepad

F2
	brightnessctl set 1%-

F3
	brightnessctl set +1%

F6
	amixer set Master toggle

F7
	amixer sset Master 1%-

F8
	amixer sset Master 1%+

F9
	amixer set Capture toggle

F10
	amixer sset Capture 5%-

F11
	amixer sset Capture 5%+

super + equal
	sh ~/src/script/mount.sh

super + BackSpace
	sh ~/src/script/exit.sh

Print
	maim -u -i $(xdotool getactivewindow) | xclip -selection clipboard -t image/png

ctrl + Print
	maim -s | xclip -selection clipboard -t image/png

ctrl + shift + Print
	 maim -s ~/Pictures/screenshots/$(date +%s).png

